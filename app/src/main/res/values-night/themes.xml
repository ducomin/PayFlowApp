<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- PayFlow dark theme overrides — already dark by default, mirrored from values/themes -->
    <style name="Theme.PayFlowApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/payflow_primary</item>
        <item name="colorOnPrimary">@color/payflow_on_primary</item>
        <item name="colorPrimaryVariant">@color/payflow_primary_container</item>
        <item name="colorSecondary">@color/payflow_secondary</item>
        <item name="colorOnSecondary">@color/payflow_on_secondary</item>
        <item name="colorSecondaryVariant">@color/payflow_secondary_container</item>
        <item name="android:windowBackground">@color/payflow_background</item>
        <item name="android:statusBarColor">@color/payflow_background</item>
        <item name="android:navigationBarColor">@color/payflow_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>