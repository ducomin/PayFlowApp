<?xml version="1.0" encoding="utf-8"?>
<!--
    PayFlow launcher background — gradiente 3-stop idêntico ao fundo do ícone na SplashScreen
    #00525C (0%) → #006874 (62%) → #3D2F00 (100%)  — fiel ao ic_launcher_background.svg
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0.0"  android:color="#FF00525C" />
                <item android:offset="0.62" android:color="#FF006874" />
                <item android:offset="1.0"  android:color="#FF3D2F00" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
